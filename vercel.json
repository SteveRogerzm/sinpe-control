{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/api/procesar",
      "dest": "/api/procesar.php"
    },
    {
      "src": "/api/obtener_registros",
      "dest": "/api/obtener_registros.php"
    },
     {
      "src": "/api/actualizar_registo",
      "dest": "/api/actualizar_registo.php"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
