{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/api/procesar.php",
      "dest": "/api/procesar.php"
    },
    {
      "src": "/api/obtener_registros.php",
      "dest": "/api/obtener_registros.php"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
